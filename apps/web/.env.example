# Postgres connection string (Supabase: Settings -> Database -> Connection string)
# Use the "Session pooler" / port 5432 URI and fill in your database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Secret used to sign auth tokens. Any long random string.
JWT_SECRET=
JWT_EXPIRATION=7d

# Supabase Storage, used by the menu image upload route.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Guards the detailed output of /api/health. Without it that route
# answers only {"status":"ok"} — set a long random value to read the setup
# diagnostics, then send it as the x-health-token header.
HEALTH_TOKEN=

# Optional. Only needed when DATABASE_URL points at the direct
# db.*.supabase.co endpoint, which is signed by Supabase's own CA rather than
# a public one. The poolers need nothing here.
# DATABASE_CA_CERT=

# Optional. Defaults to the app's own /api routes; only set this to point the
# frontend at a separately hosted API.
# NEXT_PUBLIC_API_URL=/api
